# Copy to secret.env and fill in values before applying to the cluster.
# secret.env is gitignored — never commit it.
#
# Apply with:
#   kubectl create secret generic engine-secret \
#     --from-env-file=k8s/engine/secret.env \
#     --namespace=warden \
#     --dry-run=client -o yaml | kubectl apply -f -

database-url=postgres://postgres:warden@postgres.warden.svc.cluster.local:5432/warden_engine_db?sslmode=disable
