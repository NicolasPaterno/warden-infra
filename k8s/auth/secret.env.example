# Copy to secret.env and fill in values before applying to the cluster.
# secret.env is gitignored — never commit it.
#
# Apply with:
#   kubectl create secret generic auth-secret \
#     --from-env-file=k8s/auth/secret.env \
#     --namespace=warden \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# The RSA signing key is a SEPARATE secret created from a PEM file, not from
# this env file (see `make k8s-secrets` / AUTH_KEY_FILE):
#   kubectl create secret generic auth-keys \
#     --from-file=private.pem=../warden-auth/dev-private.pem \
#     --namespace=warden

database-url=postgres://postgres:warden@postgres.warden.svc.cluster.local:5432/warden_auth_db?sslmode=disable
