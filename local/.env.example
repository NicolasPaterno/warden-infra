# Copy to .env and adjust values for your local setup.
# This file is committed. .env is gitignored.

# ─── warden-gateway ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:warden@localhost:5432/warden_gateway_db?sslmode=disable
NATS_URL=nats://localhost:4222
HTTP_PORT=:8080

# ─── warden-engine (future) ───────────────────────────────────────────────────
# ENGINE_DATABASE_URL=postgres://postgres:warden@localhost:5432/warden_engine_db?sslmode=disable
# ENGINE_NATS_URL=nats://localhost:4222
# ENGINE_GRPC_PORT=:9090

# ─── warden-auth ──────────────────────────────────────────────────────────────
# Each service reads its own .env; these are the auth values.
# AUTH_DATABASE_URL=postgres://postgres:warden@localhost:5432/warden_auth_db?sslmode=disable
# AUTH_HTTP_PORT=:8082
# AUTH_PRIVATE_KEY_PATH=dev-private.pem
# AUTH_ISSUER=warden-auth
# AUTH_AUDIENCE=warden-engine

# ─── warden-brain (future) ────────────────────────────────────────────────────
